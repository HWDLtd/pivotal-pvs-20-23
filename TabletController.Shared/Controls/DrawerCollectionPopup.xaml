<?xml version="1.0" encoding="utf-8" ?>
<ContentView
	x:Class="TabletController.Shared.Controls.DrawerCollectionPopup"
	xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
	xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
	xmlns:controls="clr-namespace:TabletController.Shared.Controls">

	<Grid x:Name="MainGrid" BackgroundColor="#80000000">
		<Border
			Padding="75"
			HorizontalOptions="Center"
			VerticalOptions="Center"
			BackgroundColor="{StaticResource White}"
			StrokeThickness="0">
			<Border.StrokeShape>
				<RoundRectangle CornerRadius="20" />
			</Border.StrokeShape>

			<VerticalStackLayout HorizontalOptions="Center" Spacing="20">
				<Label
					HorizontalOptions="Center"
					HorizontalTextAlignment="Center"
					Style="{StaticResource MainTitleBold}"
					Text="Please collect your" />

				<Label
					HorizontalOptions="Center"
					HorizontalTextAlignment="Center"
					Style="{StaticResource MainTitleBold}"
					Text="item and then" />

				<Label
					HorizontalOptions="Center"
					HorizontalTextAlignment="Center"
					Style="{StaticResource MainTitleBold}"
					Text="close the drawer" />
			</VerticalStackLayout>
		</Border>
	</Grid>
</ContentView>
