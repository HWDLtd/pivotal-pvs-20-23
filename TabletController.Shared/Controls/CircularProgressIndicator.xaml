<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="TabletController.Shared.Controls.CircularProgressIndicator"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">
    <GraphicsView
        x:Name="ProgressGraphicsView"
        HeightRequest="{Binding Source={RelativeSource AncestorType={x:Type ContentView}}, Path=HeightRequest}"
        WidthRequest="{Binding Source={RelativeSource AncestorType={x:Type ContentView}}, Path=WidthRequest}" />
</ContentView>
